# Only reviewed source and public deployment templates are tracked.
*
!.gitignore
!.dockerignore
!.env.example
!README.md
!docs/
!docs/unified-inbound-validation.md
!docs/direct-users.md
!Dockerfile
!docker-compose.yml
!go.mod
!go.sum
!cmd/
!cmd/**/
!cmd/**/*.go
!internal/
!internal/**/
!internal/**/*.go
!internal/**/testdata/*.json
!internal/**/testdata/*.sql
# Local credentials and runtime data are never public.
.env
.env.*
!.env.example
*.env
*.db
*.db-*
*.sqlite*
*.session*
*.pem
*.key
*.log
data/
backups/
bin/

# Never publish local deployments, archives, certificates or private keys.
*.bak
*.bak.*
*.backup*
*.tar
*.tar.*
*.zip
*.p12
*.pfx
*.crt
*.cer
id_rsa*
id_ed25519*
config.json
config.*.json
releases/
